{
  "name": "captcha-bypass",
  "version": "1.1.2",
  "private": true,
  "description": "Captcha bypass service.",
  "homepage": "https://github.com/Hiram-Wong/captcha-bypass",
  "license": "MIT",
  "author": {
    "name": "Hiram-Wong",
    "email": "admin@catni.cn"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "deps:check": "ncu",
    "deps:update": "ncu -u && bun install",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "typecheck": "tsc --noEmit",
    "check": "bun lint:check && bun format:check && bun typecheck",
    "prepare": "husky",
    "server": "bun --watch src/index.ts server",
    "cli": "bun --watch src/index.ts cli",
    "build:mcpb": "bun scripts/bundle-mcpb.ts",
    "build": "bun scripts/bundle-binary.ts",
    "build:win": "bun scripts/bundle-binary.ts --platform win32",
    "build:win:x64": "bun scripts/bundle-binary.ts --platform win32 --arch x64",
    "build:win:arm64": "bun scripts/bundle-binary.ts --platform win32 --arch arm64",
    "build:mac": "bun scripts/bundle-binary.ts --platform darwin",
    "build:mac:x64": "bun scripts/bundle-binary.ts --platform darwin --arch x64",
    "build:mac:arm64": "bun scripts/bundle-binary.ts --platform darwin --arch arm64",
    "build:linux": "bun scripts/bundle-binary.ts --platform linux",
    "build:linux:x64": "bun scripts/bundle-binary.ts --platform linux --arch x64",
    "build:linux:arm64": "bun scripts/bundle-binary.ts --platform linux --arch arm64",
    "build:android": "bun scripts/bundle-binary.ts --platform android",
    "build:android:x64": "bun scripts/bundle-binary.ts --platform android --arch x64",
    "build:android:arm64": "bun scripts/bundle-binary.ts --platform android --arch arm64",
    "convert:charset": "bun run ./scripts/convert-charset.ts",
    "sync:version": "bun run ./scripts/sync-version.ts",
    "gen:token": "bun run ./scripts/gen-token.ts"
  },
  "dependencies": {
    "@captcha-bypass/cli": "workspace:*",
    "@captcha-bypass/core": "workspace:*",
    "@captcha-bypass/server": "workspace:*"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "^1.4.4",
    "@types/dateformat": "^5.0.3",
    "@types/node": "^26.6.6",
    "commander": "^15.0.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-check-updates": "^23.1.1",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "~5.8.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,yml,yaml,md,css,html}": [
      "oxfmt --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "packageManager": "bun@1.4.4"
}
