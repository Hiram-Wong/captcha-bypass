{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",

  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,

  "semi": true,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "jsxSingleQuote": false,

  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",

  "proseWrap": "preserve",

  "endOfLine": "lf"
}
